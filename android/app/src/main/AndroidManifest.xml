            <category android:name="android.intent.category.DEFAULT"/>
        </intent-filter>
        <meta-data
            android:name="android.nfc.cardemulation.host_apdu_service"
            android:resource="@xml/apdu_service"/>
        <meta-data
            android:name="android.nfc.cardemulation.apdu_service.foreground"
            android:value="true"/>
    </service>
    <service
        android:name=".NfcForegroundService"
